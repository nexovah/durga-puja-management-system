# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API).
# .env is git-ignored — never commit your real values.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (used by api/billing/*.js, never exposed to the browser —
# not prefixed with VITE_, so Vite never bundles these into client code).
# Needed to run `vercel dev` locally and to test the Billing flow.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-legacy-jwt-secret
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
