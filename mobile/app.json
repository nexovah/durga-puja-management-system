{
  "expo": {
    "name": "Durga CRM",
    "slug": "durga-crm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.durgacrm.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faf8f5"
      },
      "package": "com.durgacrm.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ]
  }
}
