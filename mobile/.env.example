# Copy to .env and fill with the same values as the web app's .env
# (Supabase dashboard -> Project Settings -> API). Same Supabase project,
# same tenant data — this app is just another client against it.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
